# Copy to .env and adjust for your environment.

# Home Assistant instance URL (used by deploy messaging only)
HA_URL=http://homeassistant.local:8123/

# Path to this integration inside your HA config folder
HA_SMB_PATH=/path/to/config/custom_components/ultra_card_pro_cloud

# Optional: path to built ultra-card-panel.js from the Ultra Card frontend repo
ULTRA_CARD_PANEL_JS=../Ultra Card/dist/ultra-card-panel.js
